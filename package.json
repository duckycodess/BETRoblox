	"private": true,
	"description": "A clearer Roblox catalog and avatar experience. Chromium Manifest V3 browser extension.",
	"license": "SEE ATTRIBUTION.md",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "node tools/build-manifest.js --target=chrome",
